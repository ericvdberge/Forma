<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The studio's content (npm run studio:fixtures -w forma-app): every fixture must pass the API's validation. -->
  <ItemGroup>
    <None Include="..\Contracts\Studio\*.json" Link="Contracts\Studio\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Forma.Application\Forma.Application.csproj" />
    <ProjectReference Include="..\Forma.Infrastructure\Forma.Infrastructure.csproj" />
    <ProjectReference Include="..\Forma.Api\Forma.Api.csproj" />
  </ItemGroup>

</Project>